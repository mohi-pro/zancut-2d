        "orient_location_and_time"
      ]
    }
  ],
  "lessons": [
    {
      "id": "one-focus",
      "source": "adobe-animation",
      "rule": "Give each beat a readable main action; supporting motion must not compete with it.",
      "implementedBy": "selectVisualTreatment: dialogue/action priority"
    },
    {
      "id": "preparation",
      "source": "adobe-animation",
      "rule": "Prepare an important movement before its main pose and allow a readable finish.",
      "implementedBy": "reference guidance; existing gesture entry/exit blending, not newly learned motion"
    },
    {
      "id": "insert-purpose",
      "source": "adobe-broll",
      "rule": "Use supplemental imagery to clarify context or bridge time; preserve the important interaction.",
      "implementedBy": "selectVisualTreatment"
    },
    {
      "id": "caption-sync",
      "source": "w3c-captions",
      "rule": "Keep subtitles aligned with the narration and preserve meaning.",
      "implementedBy": "existing captionTrack"
    },
    {
      "id": "no-strobe",
      "source": "w3c-flashes",
      "rule": "Avoid strobe-like full-screen flashes; do not infer accessibility conformance from this knowledge entry alone.",
      "implementedBy": "authoring guidance only"
    },
    {
      "id": "variety",
      "source": "local-editorial-default",
      "rule": "Use an automatic insert at most once per film and separate inserts with scene shots. These limits are tunable defaults, not universal filmmaking laws.",
      "implementedBy": "selectVisualTreatment"
    },
    {
      "id": "uncertainty",
      "source": "local-editorial-default",
      "rule": "If a sentence is unclear, preserve the established world and a calm reaction. Use a relevant object insert only if supported; never insert random imagery.",
      "implementedBy": "selectVisualTreatment + planner fallback"
    },
    {
      "id": "facts-not-advice",
      "source": "local-world-contract",
      "rule": "Keep real dimensions, support surfaces, indoor/outdoor compatibility, object ownership and story time consistent. Do not invent scientific numbers or present fictional story statistics as world facts.",
      "implementedBy": "existing sizes.json and physics-logic.js; curriculum uses explicitly fictional situations"
    },
    {
      "id": "location-reference-scope",
      "source": "columbia-establishing",
      "rule": "An establishing view should orient the actual scene. Local interpretation: a remembered, pictured or planned destination does not by itself establish arrival.",
      "implementedBy": "server/location-intent.mjs; conservative Bengali/English grammar",
      "provenance": "The film principle is sourced; the reference/destination grammar is an assistant-authored local implementation choice, not a claim made by the source."
    }
  ],
  "worldModel": {
    "dimensions": "engine/cartoon/library/sizes.json",
    "places": "engine/cartoon/library/words.json",
    "identity": "server/entity-resolver.mjs",
    "supportAndGravity": "engine/cartoon/physics-logic.js",
    "unknownWords": "server/web-learner.mjs",
    "note": "These existing structured sources are executable knowledge. Downloaded prose is not automatically learned by a classifier.",
    "locationIntent": "server/location-intent.mjs"
  },
  "worldFacts": [
    {
      "id": "rain-direction",
      "source": "usgs-water",
      "fact": "Gravity brings precipitation downward and moves surface water toward lower ground.",
      "visual": "Rain falls from clouds toward ground; inside scenes show it through a window.",
      "runtime": "existing physics-logic rain and indoor/outdoor checks"
    },
    {
      "id": "water-states",
      "source": "usgs-water",
      "fact": "Water occurs as liquid, solid and gas, and moves among storage locations.",
      "visual": "Use supported cloud, rain, river or water icons when the words mention them; no invented scientific chart.",
      "runtime": "brollFor + local-world recipe checks"
    },
    {
      "id": "text-contrast",
      "source": "w3c-contrast",
      "fact": "Normal text needs a contrast ratio of at least 4.5:1 under the criterion; large text has a 3:1 threshold.",
      "visual": "Use a readable backing for captions and data labels.",
      "runtime": "existing QA R9; this is not a full accessibility certification"
    }
  ],
